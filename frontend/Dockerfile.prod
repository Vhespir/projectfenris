FROM node:20-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# Vite bakes VITE_-prefixed vars into the bundle at build time (unlike the dev
# server, which reads them at request time), so they have to arrive as build
# args here, not container env vars at runtime.
ARG VITE_CESIUM_ION_TOKEN
ENV VITE_CESIUM_ION_TOKEN=${VITE_CESIUM_ION_TOKEN}
ARG VITE_CARTO_API_KEY
ENV VITE_CARTO_API_KEY=${VITE_CARTO_API_KEY}
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.prod.conf /etc/nginx/conf.d/default.conf
# 3000, not nginx's usual 80, to match the port already hardcoded in the
# Traefik label (traefik.http.services.fenris-frontend.loadbalancer.server.port)
# in docker-compose.yml, so Traefik labels don't need to be touched again.
EXPOSE 3000
