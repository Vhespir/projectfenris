# Database
DB_NAME=fenris
DB_USER=fenris
DB_PASSWORD=changeme

# Auth
# Must be at least 32 characters, or api/index.js refuses to boot.
JWT_SECRET=changeme

# Email (Resend: https://resend.com)
# If RESEND_API_KEY is unset, every email send silently no-ops (see api/lib/email.js,
# worker/lib/alerts.js), no error, no log line, nothing. This is why welcome emails,
# password reset emails, and severe-event alert emails can all appear to just do nothing.
# EMAIL_FROM's domain must be verified in your Resend account, or sends will fail for
# any recipient other than your own Resend account email (logged as
# "[email] ... send failed:" in the api container logs, not shown to the user).
RESEND_API_KEY=changeme
EMAIL_FROM=Project Fenris <no-reply@projectfenris.com>
BASE_URL=https://projectfenris.com

# API Keys
AIRNOW_API_KEY=changeme
EIA_API_KEY=changeme
BLS_API_KEY=changeme
FRED_API_KEY=changeme

# Cesium ion access token (free tier: https://cesium.com/ion/tokens), required
# for the /map page's terrain and imagery. Without it, Cesium ion rejects every
# request with InvalidCredentials and the map effectively doesn't work.
VITE_CESIUM_ION_TOKEN=changeme

# CARTO basemaps API key (free within fair use: https://carto.com/basemaps/apikey),
# used on the dark_all raster tiles for the Dashboard map/radar widgets and the
# /map page's basemap. Without it, CARTO serves an "API KEY REQUIRED" watermark
# tile instead of map data.
VITE_CARTO_API_KEY=changeme

# Cloudflare R2 (post photo/video uploads). Create a bucket under R2 in the
# Cloudflare dashboard, enable public access on it (Settings > Public access:
# either the r2.dev subdomain it gives you, or a custom domain via CNAME),
# then create an API token under R2 > Manage API Tokens with Object
# Read & Write permissions scoped to that bucket. R2_PUBLIC_URL is whichever
# public URL you enabled, with no trailing slash. Without these set, the
# media upload endpoint returns 503 rather than failing uploads silently.
R2_ACCOUNT_ID=changeme
R2_ACCESS_KEY_ID=changeme
R2_SECRET_ACCESS_KEY=changeme
R2_BUCKET_NAME=fenris-media
R2_PUBLIC_URL=https://changeme.r2.dev

# Web Push (severe-event alerts as instant browser/OS notifications,
# alongside the existing email alerts). Generate a key pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# (run from api/ or worker/, wherever web-push is installed). The public
# key is not a secret, it's handed to browsers on purpose; the private key
# is. Without both set, push alerts are silently skipped (email still
# works fine on its own) and the Settings push toggle shows a 503.
VAPID_PUBLIC_KEY=changeme
VAPID_PRIVATE_KEY=changeme
VAPID_SUBJECT=mailto:contact@projectfenris.com

# Ports
API_PORT=3001
FRONTEND_PORT=3000
