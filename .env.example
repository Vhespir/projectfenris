# Database
DB_NAME=fenris
DB_USER=fenris
DB_PASSWORD=changeme

# Auth
# Must be at least 32 characters -- api/index.js refuses to boot otherwise.
JWT_SECRET=changeme

# Email (Resend -- https://resend.com)
# If RESEND_API_KEY is unset, every email send silently no-ops (see api/lib/email.js,
# worker/lib/alerts.js) -- no error, no log line, nothing. This is why welcome emails,
# password reset emails, and severe-event alert emails can all appear to just do nothing.
# EMAIL_FROM's domain must be verified in your Resend account, or sends will fail for
# any recipient other than your own Resend account email (logged as
# "[email] ... send failed:" in the api container logs, not shown to the user).
RESEND_API_KEY=changeme
EMAIL_FROM=Project Fenris <no-reply@projectfenris.com>
BASE_URL=https://projectfenris.com

# API Keys
AIRNOW_API_KEY=changeme
EIA_API_KEY=changeme
BLS_API_KEY=changeme
FRED_API_KEY=changeme

# Cesium ion access token (free tier: https://cesium.com/ion/tokens), required
# for the /map page's terrain and imagery. Without it, Cesium ion rejects every
# request with InvalidCredentials and the map effectively doesn't work.
VITE_CESIUM_ION_TOKEN=changeme

# CARTO basemaps API key (free within fair use: https://carto.com/basemaps/apikey),
# used on the dark_all raster tiles for the Dashboard map/radar widgets and the
# /map page's basemap. Without it, CARTO serves an "API KEY REQUIRED" watermark
# tile instead of map data.
VITE_CARTO_API_KEY=changeme

# Ports
API_PORT=3001
FRONTEND_PORT=3000
